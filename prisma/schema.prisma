generator client {
  provider        = "prisma-client-js"
  previewFeatures = []
}

datasource db {
  provider = "postgresql"
  // url moved to prisma.config.ts for Prisma 7+ compatibility
}

model User{
  id        String   @id @default(dbgenerated("uuid_v7()")) @db.Uuid
  email     String   @unique
  password  String
  name      String
  phone     String?
  avatar    String?
  bio       String?
}